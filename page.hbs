{{!< default}}
{{!-- Pages (About, Subscribe, ...): same reading column as posts, no sidebar --}}

{{#post}}

<main class="ce-main">
    <article class="ce-article ce-page {{post_class}}">

        {{#match @page.show_title_and_feature_image}}
            <header class="ce-article-header">
                <h1 class="ce-article-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="ce-article-excerpt">{{custom_excerpt}}</p>
                {{/if}}
            </header>
            {{> "feature-image"}}
        {{/match}}

        <section class="gh-content ce-content">
            {{content}}
        </section>

    </article>
</main>

{{/post}}
