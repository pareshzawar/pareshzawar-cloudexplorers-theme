{{!< default}}
{{!-- Tag page = a series index: the series name and description, then every post in it,
      numbered in reading order (oldest first). --}}

{{#tag}}
<main class="ce-main">
    <div class="ce-list-page">
        <header class="ce-list-header">
            <p class="ce-label">Series</p>
            <h1 class="ce-article-title">{{name}}</h1>
            {{#if description}}<p class="ce-article-excerpt">{{description}}</p>{{/if}}
        </header>

        {{> "ce/series-posts" slug=slug}}
    </div>
</main>
{{/tag}}
