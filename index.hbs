{{!< default}}
{{!-- All posts, page 2 onwards (the homepage is page 1): the same list as the homepage --}}

<main class="ce-main">
    <div class="ce-list-page">
        <header class="ce-list-header">
            <p class="ce-label">Archive{{#if pagination.page}} &middot; page {{pagination.page}}{{/if}}</p>
            <h1 class="ce-article-title">All posts</h1>
        </header>

        <div class="ce-rows">
            {{#foreach posts}}
                {{> "ce/post-row"}}
            {{/foreach}}
        </div>

        {{> "ce/pagination"}}
    </div>
</main>
