<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    {{!-- Basic meta - advanced meta is output with {{ghost_head}} below --}}
    <title>{{meta_title page=(t " (Page %)")}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{!-- Preload main styles and scripts for better performance --}}
    <link rel="preload" as="style" href="{{asset "built/screen.css"}}">
    <link rel="preload" as="script" href="{{asset "built/source.js"}}">

    {{!-- IBM Plex Sans + Mono, self-hosted --}}
    {{> "typography/fonts"}}

    {{!-- Source's stylesheet (Ghost cards, lightbox, forms), then the Notebook layer on top --}}
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}">
    <link rel="stylesheet" type="text/css" href="{{asset "built/cloudexplorers.css"}}">

    {{!-- Pick light or dark before first paint, so the page never flashes the wrong one.
         Order: the visitor's saved choice (theme toggle) > the "Color theme" setting in
         Ghost Admin > Design. "auto" follows the visitor's system light/dark setting.
         The has-dark-text / has-light-text class is what Source uses for its own colours. --}}
    <script>
        (function () {
            var root = document.documentElement;
            var theme = '{{#match @custom.color_theme "Light"}}light{{else match @custom.color_theme "Dark"}}dark{{else}}auto{{/match}}';
            try {
                var saved = localStorage.getItem('ce-theme');
                if (saved === 'light' || saved === 'dark') theme = saved; // ignore values saved by older versions
            } catch (e) { /* storage blocked: use the site default */ }
            if (theme === 'auto') {
                theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            root.setAttribute('data-theme', theme);
            root.className = theme === 'dark' ? 'has-light-text' : 'has-dark-text';
        })();
    </script>

    {{!-- This tag outputs all your advanced SEO meta, structured data, and other important settings, it should always be the last tag before the closing head tag --}}
    {{ghost_head}}

</head>
<body class="{{body_class}}">

<div class="gh-viewport">

    {{> "ce/header"}}

    {{{body}}}

    {{> "ce/footer"}}

</div>

{{!-- Floating Subscribe pill for anyone not subscribed yet --}}
{{#unless @member}}
    {{> "ce/subscribe-pill"}}
{{/unless}}

{{#is "post, page"}}
    {{> "lightbox"}}
{{/is}}

{{!-- Source's scripts (responsive videos, lightbox) + cloudexplorers.js, bundled together --}}
<script src="{{asset "built/source.js"}}"></script>

{{!-- Ghost outputs required functional scripts with this tag, it should always be the last thing before the closing body tag --}}
{{ghost_foot}}

{{!-- Privacy-friendly page-view counting with GoatCounter (no cookies, no consent banner needed).
     Only rendered when a code is set in Ghost Admin > Design > Site-wide > Goatcounter code. --}}
{{#if @custom.goatcounter_code}}
    <script data-goatcounter="https://{{@custom.goatcounter_code}}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{{/if}}

</body>
</html>
