<header id="gh-navigation" class="gh-navigation is-{{#match navigationLayout "Logo on the left"}}left-logo{{else match navigationLayout "Stacked"}}stacked{{else}}middle-logo{{/match}} gh-outer">
    <div class="gh-navigation-inner gh-inner">

        <div class="gh-navigation-brand">
            {{!-- Text logo "~/ce" with a blinking cursor, instead of the site logo image --}}
            <a class="gh-navigation-logo ce-logo" href="{{@site.url}}" aria-label="{{@site.title}}">
                <span class="ce-logo-tilde">~/</span>ce<span class="ce-logo-cursor" aria-hidden="true"></span>
            </a>
            {{> "search-toggle"}}
            <button class="gh-burger gh-icon-button" aria-label="{{t "Menu"}}">
                {{> "icons/burger"}}
                {{> "icons/close"}}
            </button>
        </div>

        <nav class="gh-navigation-menu">
            {{navigation}}
        </nav>

        <div class="gh-navigation-actions">
            {{!-- Members' Sign in / Subscribe buttons removed on purpose: subscribing goes through
                  the /subscribe page and the floating "Subscribe" pill instead. --}}
            {{> "search-toggle"}}
            {{> "ce/theme-toggle"}}
        </div>

    </div>
</header>
