{{!-- Big lead card on the homepage: wide image, then tag, title, excerpt, meta --}}
<article class="ce-lead">
    <a class="ce-card-link" href="{{url}}">
        {{#if feature_image}}
            <img class="ce-lead-image"
                srcset="{{img_url feature_image size="m" format="webp"}} 600w,
                        {{img_url feature_image size="l" format="webp"}} 960w,
                        {{img_url feature_image size="xl" format="webp"}} 1200w"
                sizes="(max-width: 900px) 100vw, 760px"
                src="{{img_url feature_image size="l"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        {{/if}}
        {{#if primary_tag}}<p class="ce-card-tag">{{primary_tag.name}}</p>{{/if}}
        <h2 class="ce-lead-title">{{title}}</h2>
        <p class="ce-card-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="30"}}{{/if}}</p>
        {{> "ce/meta"}}
    </a>
</article>
