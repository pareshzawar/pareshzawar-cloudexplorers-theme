{{!-- Newer / older links for paginated lists (/page/2/, author pages) --}}
{{#if pagination.pages}}
    {{#match pagination.pages ">" 1}}
        <nav class="ce-pagination" aria-label="Pages">
            {{#if pagination.prev}}<a href="{{page_url pagination.prev}}">&larr; Newer</a>{{/if}}
            <span class="ce-meta">Page {{pagination.page}} of {{pagination.pages}}</span>
            {{#if pagination.next}}<a href="{{page_url pagination.next}}">Older &rarr;</a>{{/if}}
        </nav>
    {{/match}}
{{/if}}
