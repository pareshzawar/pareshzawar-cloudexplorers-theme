{{!-- The Series list, read live from Ghost tags (name, description, post count), so renaming a
      series or editing its blurb happens in Ghost Admin > Tags, not here.

      To add or remove a series, edit the slug list in BOTH filters below (they must match).
      Ghost only returns tags that have at least one published post, so a new series appears
      in the menu and on /series/ automatically once its first post goes out (no dead links).
      Ghost sorts the result alphabetically by name.

      Parameter: layout = "menu" (header dropdown links) | "cards" (the /series/ page grid). --}}
{{#match layout "cards"}}
    <div class="ce-series-grid">
        {{#get "tags" filter="slug:[cloud-dispatches,oci-in-practice,multicloud-oracle-playbook,oracle-ai-autonomous,cloud-cost-architecture,the-lab-stack,reading-radar]" include="count.posts" limit="20" order="name asc" as |series|}}
            {{#foreach series}}
                <a class="ce-series-card" id="{{slug}}" href="{{url}}">
                    <span class="ce-series-prompt">$ route /tag/{{slug}}</span>
                    <h2>{{name}}</h2>
                    {{#if description}}<p>{{description}}</p>{{/if}}
                    <span class="ce-series-count">{{plural count.posts empty="" singular="% post" plural="% posts"}}</span>
                </a>
            {{/foreach}}
        {{/get}}
    </div>
{{else}}
    <div class="ce-series-menu">
        {{#get "tags" filter="slug:[cloud-dispatches,oci-in-practice,multicloud-oracle-playbook,oracle-ai-autonomous,cloud-cost-architecture,the-lab-stack,reading-radar]" limit="20" order="name asc" as |series|}}
            {{#foreach series}}
                <a href="{{url}}">{{name}}</a>
            {{/foreach}}
        {{/get}}
    </div>
{{/match}}
