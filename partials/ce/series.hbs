{{!-- The /series/ page list, read live from Ghost tags (name, description, post count), so
      renaming a series or editing its blurb happens in Ghost Admin > Tags, not here.
      To add or remove a series, edit the slug list in the filter below.
      Ghost only returns tags with at least one published post, so a new series appears
      here once its first post is out. Sorted alphabetically by name. --}}
<ol class="ce-series-index">
    {{#get "tags" filter="slug:[cloud-dispatches,oci-in-practice,multicloud-oracle-playbook,oracle-ai-autonomous,cloud-cost-architecture,the-lab-stack,reading-radar]" include="count.posts" limit="20" order="name asc" as |series|}}
        {{#foreach series}}
            <li class="ce-series-item" id="{{slug}}">
                <p class="ce-meta">{{plural count.posts empty="" singular="% post" plural="% posts"}}</p>
                <h2 class="ce-row-title"><a href="{{url}}">{{name}}</a></h2>
                {{#if description}}<p class="ce-row-excerpt">{{description}}</p>{{/if}}
            </li>
        {{/foreach}}
    {{/get}}
</ol>
