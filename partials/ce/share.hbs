{{!-- Share links for the current post, rendered server-side (only "Copy link" needs
      cloudexplorers.js). Must be used inside {{#post}}.
      Parameter: style = "rail" (sticky, left edge, wide screens) | "row" (end of the article). --}}
<div class="ce-share is-{{style}}" role="group" aria-label="Share this post">
    {{#match style "row"}}<span class="ce-label">Share</span>{{/match}}
    <a class="ce-share-btn" href="https://www.linkedin.com/sharing/share-offsite/?url={{encode (url absolute="true")}}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" title="LinkedIn">{{> "icons/linkedin"}}</a>
    <a class="ce-share-btn" href="https://twitter.com/intent/tweet?url={{encode (url absolute="true")}}&text={{encode title}}" target="_blank" rel="noopener noreferrer" aria-label="Share on X" title="X">{{> "icons/x"}}</a>
    <a class="ce-share-btn" href="https://wa.me/?text={{encode title}}%20{{encode (url absolute="true")}}" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp" title="WhatsApp">{{> "icons/whatsapp"}}</a>
    <a class="ce-share-btn" href="mailto:?subject={{encode title}}&body={{encode (url absolute="true")}}" aria-label="Share by email" title="Email">{{> "icons/mail"}}</a>
    <button class="ce-share-btn ce-copy-link" type="button" data-url="{{url absolute="true"}}" aria-label="Copy link" title="Copy link">{{> "icons/copy"}}</button>
</div>
