{{!-- Share row for a post. Rendered server-side, so no JavaScript is needed except for "copy link".
      Must be used inside {{#post}} so {{url}} and {{title}} refer to the current post.
      Parameter: position = "top" | "bottom" (only changes spacing). --}}
<div class="ce-share ce-share-{{position}}">
    <span class="ce-share-label">share</span>
    <a class="ce-share-box" href="https://twitter.com/intent/tweet?url={{encode (url absolute="true")}}&text={{encode title}}" target="_blank" rel="noopener noreferrer" aria-label="Share on X">{{> "icons/x"}}</a>
    <a class="ce-share-box" href="https://www.linkedin.com/sharing/share-offsite/?url={{encode (url absolute="true")}}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">{{> "icons/linkedin"}}</a>
    <a class="ce-share-box" href="https://wa.me/?text={{encode title}}%20{{encode (url absolute="true")}}" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">{{> "icons/whatsapp"}}</a>
    <button class="ce-share-box ce-copy-link" type="button" data-url="{{url absolute="true"}}" aria-label="Copy link">{{> "icons/copy"}}</button>
</div>
