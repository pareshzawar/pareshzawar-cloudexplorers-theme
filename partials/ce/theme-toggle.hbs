{{!-- Lets a visitor flip between the Terminal and Light palettes; cloudexplorers.js saves the choice.
      Hidden when "Show theme toggle" is off in Ghost Admin > Design. --}}
{{#if @custom.show_theme_toggle}}
    <button class="ce-theme-toggle gh-icon-button" type="button" aria-label="Switch colour theme" title="Switch colour theme">
        {{> "icons/theme"}}
    </button>
{{/if}}
