{{!-- Sticky share buttons on the left edge of a post (replaces the profile-links panel there).
      Server-rendered; only "copy link" needs cloudexplorers.js. Hidden on phones, where
      the share row at the end of the article is used instead. Must be inside {{#post}}. --}}
<aside class="ce-share-rail" aria-label="Share this post">
    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{encode (url absolute="true")}}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">{{> "icons/linkedin"}}</a>
    <a href="https://twitter.com/intent/tweet?url={{encode (url absolute="true")}}&text={{encode title}}" target="_blank" rel="noopener noreferrer" aria-label="Share on X">{{> "icons/x"}}</a>
    <a href="https://wa.me/?text={{encode title}}%20{{encode (url absolute="true")}}" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">{{> "icons/whatsapp"}}</a>
    <a href="mailto:?subject={{encode title}}&body={{encode (url absolute="true")}}" aria-label="Share by email">{{> "icons/mail"}}</a>
    <button class="ce-copy-link" type="button" data-url="{{url absolute="true"}}" aria-label="Copy link">{{> "icons/copy"}}</button>
</aside>
