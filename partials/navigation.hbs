{{!-- Overrides Ghost's built-in template for the {{navigation}} helper.
      Same markup as Ghost's default, except a menu item whose slug is "series"
      (Ghost Admin > Navigation, e.g. label "Series" -> /series/) gets a dropdown of the Series tags.
      The dropdown is plain HTML + CSS (:hover / :focus-within), so it needs no JavaScript. --}}
<ul class="nav">
    {{#foreach navigation}}
        {{#match slug "series"}}
            <li class="nav-{{slug}} ce-series-nav{{#if current}} nav-current{{/if}}">
                <a class="ce-series-toggle" href="{{url absolute="true"}}">{{label}}</a>
                {{> "ce/series" layout="menu"}}
            </li>
        {{else}}
            <li class="nav-{{slug}}{{#if current}} nav-current{{/if}}"><a href="{{url absolute="true"}}">{{label}}</a></li>
        {{/match}}
    {{/foreach}}
</ul>
