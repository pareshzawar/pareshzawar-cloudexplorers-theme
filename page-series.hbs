{{!< default}}
{{!-- The page with slug "series" (Ghost picks page-{slug}.hbs automatically):
      one entry per series from partials/ce/series.hbs, then any text written in the page. --}}

{{#post}}

<main class="ce-main">
    <div class="ce-list-page">
        <header class="ce-list-header">
            <p class="ce-label">Series</p>
            <h1 class="ce-article-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="ce-article-excerpt">{{custom_excerpt}}</p>{{/if}}
        </header>

        {{> "ce/series"}}

        {{#if html}}
            <section class="gh-content ce-content">
                {{content}}
            </section>
        {{/if}}
    </div>
</main>

{{/post}}
