{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#post}}

<main class="gh-main">

    {{> "ce/share-rail"}}

    <article class="gh-article {{post_class}}">

        {{!-- Article header: every tag, title, "date | N min read", then the authors --}}
        <header class="gh-article-header gh-canvas">

            {{#if tags}}
                <p class="ce-article-tags">
                    {{#foreach tags}}<a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}{{/foreach}}
                </p>
            {{/if}}
            <h1 class="gh-article-title is-title">{{title}}</h1>

            {{#if @custom.show_post_metadata}}
                <p class="ce-article-date">
                    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
                    {{#if reading_time}}<span class="ce-sep" aria-hidden="true">|</span>{{reading_time minute="1 min read" minutes="% min read"}}{{/if}}
                </p>
                <ul class="ce-article-authors">
                    {{#foreach authors}}
                        <li>
                            <a class="ce-avatar" href="{{url}}" aria-hidden="true" tabindex="-1">
                                {{#if profile_image}}<img src="{{img_url profile_image size="xs"}}" alt="">{{else}}{{> "icons/avatar"}}{{/if}}
                            </a>
                            <span>
                                <a class="ce-author-name" href="{{url}}">{{name}}</a>
                                {{#if location}}<span class="ce-author-role">{{location}}</span>{{/if}}
                            </span>
                        </li>
                    {{/foreach}}
                </ul>
            {{/if}}

            {{> "feature-image"}}

        </header>

        {{!-- Two columns on wide screens: the article, and a sticky table of contents.
              cloudexplorers.js fills the TOC from the post's h2/h3 headings and leaves it
              hidden when there are fewer than two. --}}
        <div class="ce-post-layout">
            <section class="gh-content gh-canvas is-body{{#if @custom.enable_drop_caps_on_posts}} drop-cap{{/if}}">
                {{#if custom_excerpt}}
                    <p class="ce-lead-in">{{custom_excerpt}}</p>
                {{/if}}
                {{content}}
                {{> "ce/share" position="bottom"}}
            </section>
            <nav class="ce-toc" aria-label="Table of contents" hidden>
                <p class="ce-toc-title">// contents</p>
            </nav>
        </div>

    </article>

    {{!-- About the author(s) --}}
    <section class="ce-after gh-canvas">
        {{#foreach authors}}
            <div class="ce-author-box">
                <a class="ce-avatar is-large" href="{{url}}" aria-hidden="true" tabindex="-1">
                    {{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="">{{else}}{{> "icons/avatar"}}{{/if}}
                </a>
                <div>
                    <a class="ce-author-name" href="{{url}}">{{name}}</a>
                    {{#if bio}}<p>{{bio}}</p>{{/if}}
                </div>
            </div>
        {{/foreach}}
    </section>

    {{!-- Previous / next post --}}
    <nav class="ce-prev-next gh-outer" aria-label="More posts">
        <div class="gh-inner">
            {{#prev_post}}
                <a class="ce-pn is-prev" href="{{url}}">
                    <span class="ce-pn-label">&larr; cd ../previous</span>
                    <span class="ce-pn-title">{{title}}</span>
                    {{> "ce/meta"}}
                </a>
            {{/prev_post}}
            {{#next_post}}
                <a class="ce-pn is-next" href="{{url}}">
                    <span class="ce-pn-label">cd ./next &rarr;</span>
                    <span class="ce-pn-title">{{title}}</span>
                    {{> "ce/meta"}}
                </a>
            {{/next_post}}
        </div>
    </nav>

    {{#if comments}}
        <div class="gh-comments gh-canvas">
            {{comments}}
        </div>
    {{/if}}

</main>

{{/post}}
