{{!< default}}
{{!-- Article page, "B · Notebook" design:
      left  = the article (header, content, author, series navigation, subscribe box)
      right = "On this page" (filled by cloudexplorers.js) and the list of posts in this series.
      The right column drops below the article on narrow screens. --}}

{{#post}}

<main class="ce-main">
    <div class="ce-post-layout">

        <article class="ce-article {{post_class}}">

            <header class="ce-article-header">
                {{#if @custom.show_post_metadata}}
                    <p class="ce-meta">
                        {{#if primary_tag}}<a class="ce-meta-strong" href="{{primary_tag.url}}">{{primary_tag.name}}</a><span aria-hidden="true">/</span>{{/if}}
                        {{#if reading_time}}<span>{{reading_time minute="1 min read" minutes="% min read"}}</span><span aria-hidden="true">/</span>{{/if}}
                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
                    </p>
                {{/if}}
                <h1 class="ce-article-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="ce-article-excerpt">{{custom_excerpt}}</p>
                {{/if}}
                {{#if @custom.show_post_metadata}}
                    <div class="ce-byline">
                        {{#foreach authors}}
                            <a class="ce-byline-author" href="{{url}}">
                                <span class="ce-avatar" aria-hidden="true">{{#if profile_image}}<img src="{{img_url profile_image size="xs"}}" alt="">{{/if}}</span>
                                <span>{{name}}</span>
                            </a>
                        {{/foreach}}
                    </div>
                {{/if}}
            </header>

            {{> "feature-image"}}

            <section class="gh-content ce-content">
                {{content}}
            </section>

            {{!-- About the author --}}
            {{#foreach authors}}
                <section class="ce-author" aria-label="About the author">
                    <span class="ce-avatar is-large" aria-hidden="true">{{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="">{{/if}}</span>
                    <div>
                        <a class="ce-author-name" href="{{url}}">{{name}}</a>
                        {{#if bio}}<p class="ce-author-bio">{{bio}}</p>{{/if}}
                    </div>
                </section>
            {{/foreach}}

            {{!-- Series navigation: back to the series index, and the next post in the same series.
                  Without a series tag it falls back to the previous / next post overall. --}}
            <nav class="ce-postnav" aria-label="Post navigation">
                {{#if primary_tag}}
                    <a class="ce-postnav-link" href="{{primary_tag.url}}">
                        <span class="ce-meta">&larr; Series index</span>
                        <span class="ce-postnav-title">{{primary_tag.name}}</span>
                    </a>
                    {{#next_post in="primary_tag"}}
                        <a class="ce-postnav-link is-next" href="{{url}}">
                            <span class="ce-meta">Next &rarr;</span>
                            <span class="ce-postnav-title">{{title}}</span>
                        </a>
                    {{/next_post}}
                {{else}}
                    {{#prev_post}}
                        <a class="ce-postnav-link" href="{{url}}">
                            <span class="ce-meta">&larr; Previous</span>
                            <span class="ce-postnav-title">{{title}}</span>
                        </a>
                    {{/prev_post}}
                    {{#next_post}}
                        <a class="ce-postnav-link is-next" href="{{url}}">
                            <span class="ce-meta">Next &rarr;</span>
                            <span class="ce-postnav-title">{{title}}</span>
                        </a>
                    {{/next_post}}
                {{/if}}
            </nav>

            {{> "ce/subscribe-box"}}
        </article>

        {{!-- Right column --}}
        <aside class="ce-aside" aria-label="On this page">
            <div class="ce-toc" hidden>
                <p class="ce-label">On this page</p>
                <nav class="ce-toc-links" aria-label="Table of contents"></nav>
            </div>
            {{#if primary_tag}}
                <div class="ce-aside-series">
                    <p class="ce-label">Series &middot; {{primary_tag.name}}</p>
                    {{> "ce/series-posts" slug=primary_tag.slug compact=true}}
                </div>
            {{/if}}
        </aside>

    </div>
</main>

{{/post}}
