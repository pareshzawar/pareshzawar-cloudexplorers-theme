{{!< default}}
{{!-- Author page: the author's details, then their posts --}}

<main class="ce-main">
    <div class="ce-list-page">
        {{#author}}
            <header class="ce-list-header ce-author">
                <span class="ce-avatar is-large" aria-hidden="true">{{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="">{{/if}}</span>
                <div>
                    <h1 class="ce-article-title">{{name}}</h1>
                    {{#if bio}}<p class="ce-author-bio">{{bio}}</p>{{/if}}
                    {{#if location}}<p class="ce-meta">{{location}}</p>{{/if}}
                </div>
            </header>
        {{/author}}

        <div class="ce-rows">
            {{#foreach posts}}
                {{> "ce/post-row"}}
            {{/foreach}}
        </div>

        {{> "ce/pagination"}}
    </div>
</main>
