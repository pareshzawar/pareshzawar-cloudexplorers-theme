{{!< default}}
{{!-- Homepage: a short introduction (site title + description from Ghost Admin > General),
      then the 12 newest posts as a plain list. 12 = posts_per_page, so /page/2/ continues
      exactly where this page stops. --}}

<main class="ce-main">
    <div class="ce-list-page">
        <header class="ce-list-header">
            <p class="ce-label">~/cloudexplorers.club</p>
            <h1 class="ce-article-title">{{@site.title}}</h1>
            {{#if @site.description}}<p class="ce-article-excerpt">{{@site.description}}</p>{{/if}}
        </header>

        <p class="ce-label">Latest</p>
        <div class="ce-rows">
            {{#get "posts" include="tags" limit="12" as |recent|}}
                {{#foreach recent}}
                    {{> "ce/post-row"}}
                {{/foreach}}
                {{#match recent.length ">=" 12}}
                    <a class="ce-more" href="{{@site.url}}/page/2/">Older posts &rarr;</a>
                {{/match}}
            {{/get}}
        </div>

        {{> "ce/subscribe-box"}}
    </div>
</main>
