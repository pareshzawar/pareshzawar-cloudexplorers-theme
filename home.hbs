{{!< default}}
{{!-- Homepage, "A · README terminal" hero (Claude Design):
      left  = headline, description, subscribe form and the author line
      right = a terminal window filled live from Ghost (series, latest post, post count),
              so it never needs editing when a new post goes out.
      Below: the newest post as a big tile and the next 11 as small tiles
      (12 = posts_per_page, so /page/2/ continues exactly where this page stops). --}}

<section class="ce-hero-a">
    <div class="ce-hero-a-dots" aria-hidden="true"></div>
    <div class="ce-hero-a-inner">

        <div class="ce-hero-a-text">
            <p class="ce-label"><span class="ce-accent">~/</span>cloudexplorers.club</p>
            <h1 class="ce-hero-a-title">{{#if @custom.hero_headline}}{{@custom.hero_headline}}{{else}}{{@site.title}}{{/if}}</h1>
            {{#if @site.description}}<p class="ce-hero-a-desc">{{@site.description}}</p>{{/if}}

            {{#unless @member}}
                <form class="ce-subscribe-form ce-hero-a-form" data-members-form="subscribe">
                    <div class="ce-field">
                        <label for="ce-hero-email" class="ce-sr-only">Email address</label>
                        <input id="ce-hero-email" data-members-email type="email" required placeholder="you@company.com" autocomplete="email">
                    </div>
                    <button class="ce-btn" type="submit">Subscribe</button>
                    <p class="ce-form-note ce-form-success">Check your inbox and click the link to confirm.</p>
                    <p class="ce-form-note ce-form-error" data-members-error></p>
                </form>
            {{/unless}}

            {{!-- Author line: photo and name from the site's first author, text from Design settings --}}
            {{#get "authors" limit="1" as |people|}}
                {{#foreach people}}
                    <a class="ce-hero-a-author" href="{{url}}">
                        <span class="ce-avatar is-round" aria-hidden="true">{{#if profile_image}}<img src="{{img_url profile_image size="xs"}}" alt="">{{/if}}</span>
                        <span>
                            <span class="ce-hero-a-name">{{name}}</span>
                            {{#if @custom.hero_byline}}<span class="ce-hero-a-byline">{{@custom.hero_byline}}</span>{{/if}}
                        </span>
                    </a>
                {{/foreach}}
            {{/get}}
        </div>

        {{!-- The terminal: always dark, in both themes, like a real terminal window --}}
        <div class="ce-term" role="group" aria-label="Site overview">
            <div class="ce-term-bar" aria-hidden="true">
                <span></span><span></span><span></span>
                <em>paresh@cloudexplorers: ~/ce</em>
            </div>
            <div class="ce-term-body">
                <p class="ce-term-cmd"><b>$</b> ls series/</p>
                {{#get "tags" limit="4" filter="visibility:public" include="count.posts" order="count.posts desc" as |series|}}
                    {{#foreach series}}
                        <a class="ce-term-out" href="{{url}}">{{slug}}/</a>
                    {{/foreach}}
                {{/get}}

                {{#get "posts" include="tags" limit="1" as |latest|}}
                    {{#foreach latest}}
                        <p class="ce-term-cmd"><b>$</b> head -2 latest.md</p>
                        <a class="ce-term-out" href="{{url}}"># {{title}}</a>
                        <p class="ce-term-out is-dim">{{reading_time minute="1 min read" minutes="% min read"}}{{#if primary_tag}} &middot; {{primary_tag.name}}{{/if}}</p>
                    {{/foreach}}
                {{/get}}

                {{#get "posts" limit="1" fields="id" as |one pages|}}
                    <p class="ce-term-cmd"><b>$</b> wc -l posts/</p>
                    <p class="ce-term-out">{{pages.total}} posts</p>
                {{/get}}

                <p class="ce-term-cmd"><b>$</b> <span class="ce-term-cursor" aria-hidden="true"></span></p>
            </div>
        </div>

    </div>
</section>

<main class="ce-main">
    <div class="ce-list-page">
        {{#get "posts" include="tags" limit="12" as |recent|}}
            {{!-- Newest post: the big featured tile --}}
            <div class="ce-list-head">
                <h2 class="ce-label">Latest</h2>
                <a class="ce-list-more" href="{{@site.url}}/page/2/">All posts &rarr;</a>
            </div>
            {{#foreach recent limit="1"}}
                {{> "ce/post-tile" featured=true}}
            {{/foreach}}

            {{!-- Everything after it: small tiles in a grid --}}
            {{#match recent.length ">" 1}}
                <div class="ce-list-head">
                    <h2 class="ce-label">Earlier posts</h2>
                </div>
                <div class="ce-tiles">
                    {{#foreach recent from="2"}}
                        {{> "ce/post-tile"}}
                    {{/foreach}}
                </div>
            {{/match}}

            {{#match recent.length ">=" 12}}
                <a class="ce-more" href="{{@site.url}}/page/2/">Older posts &rarr;</a>
            {{/match}}
        {{/get}}
    </div>
</main>
