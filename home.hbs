{{!< default}}
{{!-- Homepage: a shaded intro band (site title + description from Ghost Admin > General),
      kept visually separate from the posts below it, then the 12 newest posts.
      12 = posts_per_page, so /page/2/ continues exactly where this page stops. --}}

<section class="ce-hero">
    <div class="ce-hero-inner">
        <p class="ce-label">~/cloudexplorers.club</p>
        <h1 class="ce-hero-title">{{@site.title}}</h1>
        {{#if @site.description}}<p class="ce-hero-desc">{{@site.description}}</p>{{/if}}
    </div>
</section>

<main class="ce-main">
    <div class="ce-list-page">
        <h2 class="ce-label ce-list-label">Latest posts</h2>
        <div class="ce-rows">
            {{#get "posts" include="tags" limit="12" as |recent|}}
                {{#foreach recent}}
                    {{> "ce/post-row"}}
                {{/foreach}}
                {{#match recent.length ">=" 12}}
                    <a class="ce-more" href="{{@site.url}}/page/2/">Older posts &rarr;</a>
                {{/match}}
            {{/get}}
        </div>

        {{> "ce/subscribe-box"}}
    </div>
</main>
