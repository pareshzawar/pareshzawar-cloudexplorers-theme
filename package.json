{
    "name": "cloudexplorers",
    "description": "Ghost theme for cloudexplorers.club: the Notebook design (IBM Plex, greyscale, light/dark), built on Source",
    "demo": "https://cloudexplorers.club",
    "version": "2.0.0",
    "engines": {
        "ghost": ">=5.0.0",
        "node": ">=22.12.0"
    },
    "license": "MIT",
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip",
        "build": "gulp build",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "pretest": "pnpm zip",
        "pretest:ci": "pnpm zip"
    },
    "packageManager": "pnpm@11.24.0",
    "author": {
        "name": "Paresh Zawar",
        "email": "przawar@proton.me",
        "url": "https://cloudexplorers.club"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/pareshzawar/pareshzawar-cloudexplorers-theme.git"
    },
    "devDependencies": {
        "@tryghost/release-utils": "0.9.1",
        "@tryghost/theme-translations": "0.0.22",
        "autoprefixer": "10.5.4",
        "beeper": "2.1.0",
        "cssnano": "9.0.1",
        "gscan": "6.4.2",
        "gulp": "5.0.1",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "10.0.0",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "6.1.0",
        "inquirer": "14.2.0",
        "postcss": "8.5.26",
        "postcss-easy-import": "4.0.0",
        "pump": "3.0.4"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 12,
        "image_sizes": {
            "xs": {
                "width": 160
            },
            "s": {
                "width": 320
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 960
            },
            "xl": {
                "width": 1200
            },
            "xxl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "color_theme": {
                "type": "select",
                "options": [
                    "Auto",
                    "Light",
                    "Dark"
                ],
                "default": "Auto",
                "description": "Auto follows each visitor’s system light/dark setting"
            },
            "show_theme_toggle": {
                "type": "boolean",
                "default": true,
                "description": "Show the light/dark button in the header"
            },
            "goatcounter_code": {
                "type": "text",
                "default": "cloudexplorers",
                "description": "Your GoatCounter code (the “xyz” in xyz.goatcounter.com). Leave empty to disable analytics"
            },
            "show_post_metadata": {
                "type": "boolean",
                "default": true,
                "group": "post",
                "description": "Series, read time, date and author at the top of posts"
            },
            "hero_headline": {
                "type": "text",
                "default": "Real-world Oracle Cloud, from landing zones to AI.",
                "group": "homepage",
                "description": "Big headline at the top of the homepage"
            },
            "hero_byline": {
                "type": "text",
                "default": "Oracle Cloud Architect · 25 Oracle certifications",
                "group": "homepage",
                "description": "Line under your name in the homepage intro"
            }
        }
    }
}
